# Configuration for the runner. Copy to runner.env; keep it private. The variables were specified in
# https://github.com/Lementknight/zig-actions-runner/blob/7641a69/docs/SPEC.md §2, which predates
# RUNNER_TRUSTED_REFS, RUNNER_TRUSTED_EVENTS, RUNNER_ZIG_LOCAL_CACHE and RUNNER_ZIG_SEED;
# runner/src/config.zig (fromEnviron) reads them all.

# A token that may manage self-hosted runners for GH_SCOPE: a fine-grained token with the
# repository permission "Administration: read and write" (an organization: "Self-hosted runners:
# read and write"), or a classic token with `repo` (`admin:org` for an organization).
GH_TOKEN=
# owner/repo, or an organization name.
GH_SCOPE=

# prod (README, "Environments"): run only jobs from these refs, whose workflow file comes from one
# of them too, and from these events; a trailing * matches any rest. Fail everything else before
# any step runs. Unset or empty trusts no ref, so every job fails, and a runner with the prod label
# refuses to start. `*` trusts every ref: only on a machine untrusted code may reach (pre-prod).
RUNNER_TRUSTED_REFS=refs/heads/main,refs/tags/v*
# Unset: push,workflow_dispatch. `*` trusts every event; empty, none.
# RUNNER_TRUSTED_EVENTS=push,workflow_dispatch

# How many jobs this machine runs at once, at most.
RUNNER_COUNT=4
# On a stop (SIGTERM), seconds a running job gets to finish before it is cancelled. Keep the
# service's TimeoutStopSec (compose: stop_grace_period) about 5 minutes above it.
# RUNNER_STOP_GRACE_SECS=600

# The memory gate (#126): a runner asks GitHub for a job only while the machine has the memory for
# it; otherwise it removes its registration and waits, looking again every 5 s, and logs once when
# it holds back and once when it goes on. Running jobs are never touched. On by default; each limit
# below is turned off by 0. Four `zig build test` jobs taken at once on razorbill (8 GB, the engine
# capped at 4 GB) filled the engine and its swap, and the Pi thrashed for hours.
# RUNNER_ADMISSION=true
# MemAvailable (/proc/meminfo) that must be left after reserving RUNNER_MEM_PER_JOB_MB for this job,
# for each runner of the process already polling, and for each job started in the last 2 minutes
# (its memory does not show yet). razorbill idles at about 5.5 GB available, so three runners
# poll at once (1536 + 3 x 1024 = 4608) and a fourth waits until one job's memory shows: four
# heavy jobs (about 1 GB each, with the engine's 600 MB) do not fit under the engine's 4 GB cap,
# three do. Light jobs are not slowed beyond that: two minutes in, only their real use counts.
# Where the engine's cgroup is found (below), a job whose name has run before reserves, while it
# starts, the most its last 5 runs raised the engine's memory by, instead of RUNNER_MEM_PER_JOB_MB
# (#144): a uv job 300 MB, `zig build test` 1.6 GB. Runs that shared the engine with another job
# measured both, so they count only until the job has run alone (the least of them, until then).
# A runner polling, or a job not seen yet, still reserves RUNNER_MEM_PER_JOB_MB, or the most any
# job was seen to take if that is more. What was learned is in memory only: after a restart every
# job reserves the worst case until it has run.
# Runners in another process (a second pool) are not counted: one pool per machine is best.
# RUNNER_MIN_MEM_AVAILABLE_MB=1536
# RUNNER_MEM_PER_JOB_MB=1024
# Memory pressure, PSI `some avg10` (/proc/pressure/memory), in percent: how much of the last 10 s
# some task spent waiting for memory. It catches what MemAvailable misses, the engine swapping at
# its own cgroup cap while the host has memory left. A healthy machine sits at 0; thrashing is
# over 50. Resumes under half. No signal where PSI is off (`psi=0`, or a kernel without it).
# RUNNER_MAX_MEM_PRESSURE=10
# Swap growth, in MB a minute: for kernels without PSI, and the engine cgroup's own swap
# (memory.swap.current) below. Resumes under half. Swap merely in use is not counted: pages stay
# there long after the burst that put them there.
# RUNNER_MAX_SWAP_GROWTH_MB=64
# The engine's own memory cap (#142): the same reservations, against the engine container's cgroup.
# With 4 jobs in flight razorbill's engine hit its 4 GB cap and swapped 1 GB in 30 s while the host
# still showed 2 GB available (4.8 GB as each job was let through). In use is memory.current less
# inactive_file and slab_reclaimable: the engine's inactive file cache and the kernel's dentry and
# inode cache, which it drops first, hold nobody. `docker stats` subtracts only the first, so it
# reads 200-300 MB higher than the log on the Pi. This much must be left under the cap after the
# reservations. The engine idles at about 1 GB of 4 GB by this measure (its own heap about 650 MB
# plus the files it is reading; the 2026-10-31 sweep, to be re-checked against the next soak): two
# jobs (256 + 2 x 1024 = 2304) fit from 1 GB, three (3328) from under 770 MB; a fourth waits.
# Resumes with 256 MB more.
# RUNNER_MIN_ENGINE_HEADROOM_MB=256
# Unset: found through RUNNER_ENGINE_HOST's unix socket (the process listening on it, its
# /proc/<pid>/cgroup, then the nearest cgroup above with a memory.max), with no Docker access. The
# log says which ("the engine's cgroup is ..., capped at 4.0 GB"), or why not, and the gate then
# sees the host only: an engine over TCP or through Docker, one with no cap, or a runner in a
# container that cannot see the engine's processes (deploy/compose.yaml). Not found is retried
# every minute, so an engine that starts after the runner is picked up. A cgroup directory sets
# it; `none` turns it off.
# RUNNER_ENGINE_CGROUP=/sys/fs/cgroup/system.slice/docker-<container id>.scope
# Seconds a step may wait with nothing at all heard from the engine (no health check, which it
# sends every 5 s, no answer, no log line) before its session is aborted and the step failed
# (#100). A swapping engine answers late, not that late; 0 turns it off.
# RUNNER_ENGINE_SILENCE_TIMEOUT=600
# Labels jobs select with `runs-on: [self-hosted, prod]`.
RUNNER_LABELS=self-hosted,linux,zig,prod
RUNNER_NAME_PREFIX=zig

# Steps run as `runner` (uid 1001, passwordless sudo), as on GitHub; `root` runs them as root.
# RUNNER_STEP_USER=runner
# Experimental: replay the steps after a secret-using step when its output is unchanged.
# RUNNER_OUTPUT_KEYS=false
# Their cost follows the size of the job's filesystem, not of what changed (1 s on a small
# checkout, 25 s on a large one). A job over this many milliseconds turns them off for that
# repository until the runner restarts; 0 never skips.
# RUNNER_OUTPUT_KEYS_MAX_MS=10000
# uv's project environment lives in uv's cache volume, so uv hardlinks instead of copying every
# file (28.6 s -> 0.5 s for flask on a Raspberry Pi); the workspace's .venv links to it.
# Only in jobs without step caching: with it, the environment stays in the workspace, so a
# replayed `uv sync` restores it exactly instead of leaving another commit's dependencies.
# RUNNER_UV_ENV_IN_CACHE=true
# Seed the Zig global cache of jobs that run Zig with Zig 0.17's build runner, built once per
# engine from this Zig release (104 s on one core; a cold `zig build test` of zig-runner went from
# 146 s to 49 s). <version>=<sha256 of zig-<arch>-linux-<version>.tar.xz for this machine>, from
# https://ziglang.org/download/index.json; keep it at the version .github/scripts/install-zig.sh
# pins. Off when unset. On x86_64:
# RUNNER_ZIG_SEED=0.17.0=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
# On aarch64 (a Raspberry Pi):
# RUNNER_ZIG_SEED=0.17.0=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8

# Optional: run state and logs in Postgres / Tiger Data, for the read API and web UI.
# DATABASE_URL=postgres://user:password@host:5432/tsdb?sslmode=require
