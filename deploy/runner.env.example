# Configuration for the runner. Copy to runner.env; keep it private. The variables were specified in
# https://github.com/Lementknight/zig-actions-runner/blob/7641a69/docs/SPEC.md §2, which predates
# RUNNER_TRUSTED_REFS, RUNNER_TRUSTED_EVENTS and RUNNER_ZIG_LOCAL_CACHE; runner/src/config.zig
# (fromEnviron) reads them all.

# A token that may manage self-hosted runners for GH_SCOPE: a fine-grained token with the
# repository permission "Administration: read and write" (an organization: "Self-hosted runners:
# read and write"), or a classic token with `repo` (`admin:org` for an organization).
GH_TOKEN=
# owner/repo, or an organization name.
GH_SCOPE=

# prod (README, "Environments"): run only jobs from these refs, whose workflow file comes from one
# of them too, and from these events; a trailing * matches any rest. Fail everything else before
# any step runs. Unset runs every job: only on a machine untrusted code may reach (pre-prod).
RUNNER_TRUSTED_REFS=refs/heads/main,refs/tags/v*
# RUNNER_TRUSTED_EVENTS=push,workflow_dispatch

# How many jobs this machine runs at once.
RUNNER_COUNT=4
# Labels jobs select with `runs-on: [self-hosted, prod]`.
RUNNER_LABELS=self-hosted,linux,zig,prod
RUNNER_NAME_PREFIX=zig

# Steps run as `runner` (uid 1001, passwordless sudo), as on GitHub; `root` runs them as root.
# RUNNER_STEP_USER=runner
# Experimental: replay the steps after a secret-using step when its output is unchanged.
# RUNNER_OUTPUT_KEYS=false
# Their cost follows the size of the job's filesystem, not of what changed (1 s on a small
# checkout, 25 s on a large one). A job over this many milliseconds turns them off for that
# repository until the runner restarts; 0 never skips.
# RUNNER_OUTPUT_KEYS_MAX_MS=10000
# uv's project environment lives in uv's cache volume, so uv hardlinks instead of copying every
# file (28.6 s -> 0.5 s for flask on a Raspberry Pi); the workspace's .venv links to it.
# Only in jobs without step caching: with it, the environment stays in the workspace, so a
# replayed `uv sync` restores it exactly instead of leaving another commit's dependencies.
# RUNNER_UV_ENV_IN_CACHE=true

# Optional: run state and logs in Postgres / Tiger Data, for the read API and web UI.
# DATABASE_URL=postgres://user:password@host:5432/tsdb?sslmode=require
