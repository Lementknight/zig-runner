# pre-prod (README, "Environments"): the runner for pull requests and other untrusted jobs, on a
# machine of its own with nothing worth reaching: no secrets, no other services, not the prod
# machine. Everything not set here is as in runner.env.example. Copy to runner.env; keep it private.

GH_TOKEN=
GH_SCOPE=

RUNNER_COUNT=2
# Labels jobs select with `runs-on: [self-hosted, pre-prod]`.
RUNNER_LABELS=self-hosted,linux,zig,pre-prod
RUNNER_NAME_PREFIX=zig-preprod

# Every job runs here: no RUNNER_TRUSTED_REFS.
# No access to the job's Dagger engine from its steps: that access can run privileged containers,
# which is control of this machine.
RUNNER_DAGGER_NESTING=false
